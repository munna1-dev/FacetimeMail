{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:api && npm run build:web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/health",
      "destination": "/api/[...path]"
    },
    {
      "source": "/:path((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
